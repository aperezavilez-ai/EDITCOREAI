{
  "version": 2,
  "framework": null,
  "outputDirectory": "web-portal",
  "buildCommand": "node scripts/write-web-config.js",
  "installCommand": "",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "routes": [
    { "src": "/api/chat", "dest": "/web-portal/api/chat.js" },
    { "src": "/api/create-checkout", "dest": "/web-portal/api/create-checkout.js" },
    { "src": "/api/webhook-stripe", "dest": "/web-portal/api/webhook-stripe.js" },
    { "src": "/api/webhook-mercadopago", "dest": "/web-portal/api/webhook-mercadopago.js" },
    { "src": "/(download|descargar)", "dest": "https://github.com/aperezavilez-ai/EDITCOREAI/releases/latest/download/EDITCOREAI-Setup.exe", "status": 302, "headers": { "Location": "https://github.com/aperezavilez-ai/EDITCOREAI/releases/latest/download/EDITCOREAI-Setup.exe", "Cache-Control": "no-store" } },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/web-portal/index.html" }
  ]
}
