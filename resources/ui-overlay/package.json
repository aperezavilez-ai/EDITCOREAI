{
  "name": "editcoreai",
  "version": "3.0.2",
  "description": "EditCoreAI â€” IDE con agente (MEAI/APICREDITS)",
  "author": "EditCoreAI",
  "private": true,
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/aperezavilez-ai/EDITCOREAI.git"
  },
  "scripts": {
    "start": "node scripts/sync-app.js && node scripts/ensure-editcore-shortcuts.js && node scripts/start-editcore.js",
    "postinstall": "node scripts/brand-electron-runtime.js",
    "brand:electron": "node scripts/brand-electron-runtime.js --force",
    "sync": "node scripts/sync-app.js",
    "test": "node --test test/*.test.js runtime/*.test.js",
    "test:e2e": "node --test test/e2e-operator.test.js test/forensic-pipeline-e2e.test.js",
    "test:e2e:electron": "node scripts/forensic-pipeline-electron-e2e.js",
    "verify:prepackage": "node --test test/pre-package-gate.test.js && npm test",
    "test:runtime": "node --test runtime/*.test.js",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --check project-analysis.js && node --check runtime/editcore-claude-adapter.js && node --check runtime/action-registry.js && node --check runtime/ai-core.js && node --check runtime/task-manager.js && node --check runtime/workspace-api.js && node --check runtime/tool-dispatcher.js",
    "dist:win": "node scripts/build-windows.js",
    "release:win": "electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.12.3",
    "monaco-editor": "^0.52.2",
    "pdf-parse": "^1.1.4",
    "pdfkit": "^0.20.2",
    "typescript": "^5.9.3",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0",
    "puppeteer": "^24.2.0"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.0",
    "electron": "^43.7.0",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "build": {
    "appId": "com.editcoreai.app",
    "productName": "EditCoreAI",
    "executableName": "EDITCOREAI",
    "buildVersion": "3.0.2.0",
    "artifactName": "EDITCOREAI-Setup.${ext}",
    "win": {
      "icon": "assets/logo.ico",
      "signExecutable": false,
      "target": [
        "nsis"
      ],
      "artifactName": "EDITCOREAI-Setup.${ext}"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "app/**/*",
      "src/**/*",
      "!.editcore/**",
      "!resources/rtk/**",
      "!resources/ui-overlay/**",
      "!resources/app.asar",
      "!test/**",
      "!scripts/**",
      "!phase*-results/**",
      "!scratch/**",
      "!**/*.log",
      "!*.md",
      "!node_modules/.cache/**",
      "!node_modules/monaco-editor/dev/**",
      "!node_modules/monaco-editor/esm/**",
      "!node_modules/monaco-editor/min-maps/**"
    ],
    "asarUnpack": [
      "node_modules/monaco-editor/min/**",
      "node_modules/xterm/**",
      "node_modules/xterm-addon-fit/**",
      "node_modules/node-pty/**",
      "ide/**"
    ],
    "extraResources": [
      {
        "from": "resources/rtk/rtk.exe",
        "to": "rtk/rtk.exe"
      },
      {
        "from": "resources/ui-overlay",
        "to": "ui-overlay",
        "filter": [
          "**/*",
          "!**/node_modules/**",
          "!**/electron/**"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EditCoreAI",
      "deleteAppDataOnUninstall": false
    }
  },
  "productName": "EditCoreAI"
}

